# Copy to .env and fill in. Only VITE_* values are bundled into the app and all are public-safe.
# Supabase → Project Settings → API (use the anon/publishable key, NEVER the service_role/secret key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
# Web Push public VAPID key (the private key is stored only in Supabase Vault)
VITE_VAPID_PUBLIC_KEY=
# Optional: internal domain used to map usernames to auth identities (no email is ever sent)
# VITE_AUTH_EMAIL_DOMAIN=users.habitnest.invalid
